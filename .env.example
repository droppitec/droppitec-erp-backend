# Plantilla de variables de entorno del backend.
# Copiar a ".env" y completar con valores reales.
# En Vercel se cargan estas mismas claves en Settings > Environment Variables.

# --- Servidor ---
PORT=8080
NODE_ENV=development
# VERCEL lo setea Vercel automaticamente a "1" en produccion. No tocar localmente.

# --- Seguridad / Auth ---
JWT_SECRET=
API_KEY=
API_TOKEN=
USER_TOKEN=

# --- Email (nodemailer) ---
EMAIL=
EMAIL_PASSWORD=
GENERATED_APP_PASSWORD=

# --- Pagos SIRO ---
SIRO_USER=
SIRO_PASSWORD=

# --- Base de datos (Supabase) ---
# Usar la connection string del POOLER (Transaction, puerto 6543), no la directa.
DB_USER=
DB_HOST=
DB_NAME=postgres
DB_PASSWORD=
DB_PORT=6543
